.idea/
.claude/

# Bản chép tạm để đẩy đi. Nguồn là landing/, chép sang đây bằng
# scripts/stage-landing.py, rồi scripts/push-repo-landing.py đẩy vào repo của
# từng dự án. Ghi đè mỗi lần chạy — đừng sửa gì trong đây.
build/
__pycache__/
*.pyc

# Thư mục tải về ban đầu. Nội dung đã gộp vào landing/ ngày 11/09/2026, đối
# chiếu khớp từng byte cả 70 file. Giữ ignore để không tồn tại hai bản song
# song rồi sửa nhầm bản không ai đọc. landing/ là nguồn duy nhất.
# Xoá được thư mục này bất cứ lúc nào.
Portfolio redesign scope/

